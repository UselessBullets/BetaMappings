	FIELD c grass Lcm;
	FIELD d sand Lcm;
	FIELD e cloth Lcm;
	FIELD f fire Lcm;
	FIELD g ice Lcm;
	FIELD h metal Lcm;
	FIELD i plant Lcm;
	FIELD j snow Lcm;
	FIELD k clay Lcm;
	FIELD l dirt Lcm;
	FIELD m stone Lcm;
	FIELD n water Lcm;
	FIELD o wood Lcm;
